{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pqc-scan",
          "version": "0.3.0",
          "informationUri": "https://github.com/YusufTaha-Kurt/pqc-scan",
          "rules": [
            {
              "id": "pqc/broken/rsa",
              "name": "rsa",
              "shortDescription": {
                "text": "BROKEN: RSA"
              },
              "fullDescription": {
                "text": "RSA key shorter than 2048 bits is weak even without a quantum computer"
              },
              "help": {
                "text": "Migrate signatures to ML-DSA (FIPS 204) and key transport to ML-KEM (FIPS 203).",
                "markdown": "Migrate signatures to ML-DSA (FIPS 204) and key transport to ML-KEM (FIPS 203)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "BROKEN"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "pqc/broken/3des",
              "name": "3des",
              "shortDescription": {
                "text": "BROKEN: DESede"
              },
              "fullDescription": {
                "text": "64-bit block size (Sweet32); disallowed by NIST since 2024"
              },
              "help": {
                "text": "Use AES-256-GCM.",
                "markdown": "Use AES-256-GCM."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "BROKEN"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "pqc/broken/ecb",
              "name": "ecb",
              "shortDescription": {
                "text": "BROKEN: ECB"
              },
              "fullDescription": {
                "text": "ECB mode leaks patterns in the plaintext"
              },
              "help": {
                "text": "Use an AEAD mode such as AES-256-GCM.",
                "markdown": "Use an AEAD mode such as AES-256-GCM."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "BROKEN"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "pqc/broken/md5",
              "name": "md5",
              "shortDescription": {
                "text": "BROKEN: MD5"
              },
              "fullDescription": {
                "text": "MD5 collisions are practical"
              },
              "help": {
                "text": "Use SHA-384, SHA-512 or SHA3.",
                "markdown": "Use SHA-384, SHA-512 or SHA3."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "BROKEN"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "pqc/broken/sha1",
              "name": "sha1",
              "shortDescription": {
                "text": "BROKEN: SHA1"
              },
              "fullDescription": {
                "text": "SHA-1 collisions are practical (SHAttered, 2017)"
              },
              "help": {
                "text": "Use SHA-384 or SHA-512 (HMAC-SHA-256 or better for MACs).",
                "markdown": "Use SHA-384 or SHA-512 (HMAC-SHA-256 or better for MACs)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "BROKEN"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "pqc/broken/tls1.1",
              "name": "tls1.1",
              "shortDescription": {
                "text": "BROKEN: TLSv1.1"
              },
              "fullDescription": {
                "text": "TLS 1.1 is deprecated (RFC 8996)"
              },
              "help": {
                "text": "Disable it; use TLS 1.3.",
                "markdown": "Disable it; use TLS 1.3."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "BROKEN"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "pqc/broken/tls1.0",
              "name": "tls1.0",
              "shortDescription": {
                "text": "BROKEN: TLSv1.0"
              },
              "fullDescription": {
                "text": "TLS 1.0 is deprecated (RFC 8996)"
              },
              "help": {
                "text": "Disable it; use TLS 1.3.",
                "markdown": "Disable it; use TLS 1.3."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "BROKEN"
                ],
                "security-severity": "8.0"
              }
            },
            {
              "id": "pqc/vulnerable/ec",
              "name": "ec",
              "shortDescription": {
                "text": "VULNERABLE: EC"
              },
              "fullDescription": {
                "text": "Elliptic-curve cryptography is broken by Shor's algorithm"
              },
              "help": {
                "text": "Migrate signatures to ML-DSA and key exchange to ML-KEM (hybrid during transition).",
                "markdown": "Migrate signatures to ML-DSA and key exchange to ML-KEM (hybrid during transition)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "VULNERABLE"
                ],
                "security-severity": "6.0"
              }
            },
            {
              "id": "pqc/vulnerable/ecdsa",
              "name": "ecdsa",
              "shortDescription": {
                "text": "VULNERABLE: ECDSA"
              },
              "fullDescription": {
                "text": "ECDSA is broken by Shor's algorithm"
              },
              "help": {
                "text": "Migrate to ML-DSA (FIPS 204) or SLH-DSA (FIPS 205).",
                "markdown": "Migrate to ML-DSA (FIPS 204) or SLH-DSA (FIPS 205)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "VULNERABLE"
                ],
                "security-severity": "6.0"
              }
            },
            {
              "id": "pqc/vulnerable/ed25519",
              "name": "ed25519",
              "shortDescription": {
                "text": "VULNERABLE: Ed25519"
              },
              "fullDescription": {
                "text": "Ed25519 is broken by Shor's algorithm"
              },
              "help": {
                "text": "Plan migration to ML-DSA (FIPS 204) or SLH-DSA (FIPS 205).",
                "markdown": "Plan migration to ML-DSA (FIPS 204) or SLH-DSA (FIPS 205)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "VULNERABLE"
                ],
                "security-severity": "6.0"
              }
            },
            {
              "id": "pqc/vulnerable/ecdh",
              "name": "ecdh",
              "shortDescription": {
                "text": "VULNERABLE: ECDH"
              },
              "fullDescription": {
                "text": "Elliptic-curve Diffie-Hellman is broken by Shor's algorithm"
              },
              "help": {
                "text": "Use hybrid X25519MLKEM768 or SecP256r1MLKEM768 (TLS 1.3).",
                "markdown": "Use hybrid X25519MLKEM768 or SecP256r1MLKEM768 (TLS 1.3)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "VULNERABLE"
                ],
                "security-severity": "6.0"
              }
            },
            {
              "id": "pqc/vulnerable/rsa",
              "name": "rsa",
              "shortDescription": {
                "text": "VULNERABLE: RSA"
              },
              "fullDescription": {
                "text": "RSA is broken by Shor's algorithm at every key size"
              },
              "help": {
                "text": "Migrate signatures to ML-DSA (FIPS 204) and key transport to ML-KEM (FIPS 203).",
                "markdown": "Migrate signatures to ML-DSA (FIPS 204) and key transport to ML-KEM (FIPS 203)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "VULNERABLE"
                ],
                "security-severity": "6.0"
              }
            },
            {
              "id": "pqc/vulnerable/x25519",
              "name": "x25519",
              "shortDescription": {
                "text": "VULNERABLE: X25519"
              },
              "fullDescription": {
                "text": "X25519 on its own is broken by Shor's algorithm"
              },
              "help": {
                "text": "Use hybrid X25519MLKEM768 (TLS) or mlkem768x25519-sha256 (SSH).",
                "markdown": "Use hybrid X25519MLKEM768 (TLS) or mlkem768x25519-sha256 (SSH)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "VULNERABLE"
                ],
                "security-severity": "6.0"
              }
            },
            {
              "id": "pqc/weakened/aes",
              "name": "aes",
              "shortDescription": {
                "text": "WEAKENED: AES"
              },
              "fullDescription": {
                "text": "AES with a key shorter than 256 bits loses half its security to Grover's algorithm"
              },
              "help": {
                "text": "Use AES-256.",
                "markdown": "Use AES-256."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "WEAKENED"
                ],
                "security-severity": "4.0"
              }
            },
            {
              "id": "pqc/weakened/sha1",
              "name": "sha1",
              "shortDescription": {
                "text": "WEAKENED: HMAC-SHA1"
              },
              "fullDescription": {
                "text": "HMAC-SHA1 is not affected by SHA-1 collisions but has a small security margin"
              },
              "help": {
                "text": "Use SHA-384 or SHA-512 (HMAC-SHA-256 or better for MACs).",
                "markdown": "Use SHA-384 or SHA-512 (HMAC-SHA-256 or better for MACs)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "WEAKENED"
                ],
                "security-severity": "4.0"
              }
            },
            {
              "id": "pqc/weakened/sha224",
              "name": "sha224",
              "shortDescription": {
                "text": "WEAKENED: sha224"
              },
              "fullDescription": {
                "text": "224-bit output leaves a thin margin against quantum search"
              },
              "help": {
                "text": "Use SHA-384 or SHA-512.",
                "markdown": "Use SHA-384 or SHA-512."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "WEAKENED"
                ],
                "security-severity": "4.0"
              }
            },
            {
              "id": "pqc/unknown/aes",
              "name": "aes",
              "shortDescription": {
                "text": "UNKNOWN: AES"
              },
              "fullDescription": {
                "text": "AES key size could not be determined"
              },
              "help": {
                "text": "Use AES-256.",
                "markdown": "Use AES-256."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "cryptography",
                  "post-quantum",
                  "UNKNOWN"
                ],
                "security-severity": "2.0"
              }
            }
          ]
        }
      },
